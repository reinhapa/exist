{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "dependencyDashboard": true,
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchFileNames": ["pom.xml", "**/pom.xml"],
      "enabled": false
    }
  ],
  "schedule": [
    "at any time"
  ]
}
